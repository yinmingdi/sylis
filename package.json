{
  "name": "sylis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "./scripts/start-all.sh",
    "dev": "./scripts/start-dev.sh",
    "docs": "./scripts/start-docs.sh",
    "dev:web": "pnpm --filter ./apps/web run dev",
    "dev:api": "pnpm --filter ./apps/api run dev",
    "build": "turbo run build docs:build",
    "build:api": "pnpm --filter ./apps/api run build",
    "build:web": "pnpm --filter ./apps/web run build",
    "build:docs": "pnpm --filter ./docs/overview run docs:build",
    "build:components": "pnpm --filter ./docs/components run build",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .turbo && rm -rf node_modules",
    "clean:cache": "pnpm store prune && pnpm -r exec rm -rf .turbo",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "phase0:format:check": "prettier --check turbo.json package.json eslint.config.js .github/workflows apps/api/eslint.config.js apps/api/package.json apps/api/nest-cli.json apps/web/eslint.config.js apps/web/package.json packages/*/package.json packages/*/tsdown.config.ts services/vocabulary-importer/package.json docs/components/package.json docs/overview/package.json docs/overview/adr docs/overview/refactor docs/overview/guide/lexicon-architecture.md tools/architecture",
    "turbo:graph": "turbo run build --graph=.turbo/task-graph.html",
    "ci:affected": "turbo run lint typecheck test build docs:build --affected --concurrency=50%",
    "ci:full": "turbo run lint typecheck test build docs:build --concurrency=50%",
    "architecture:check": "node tools/architecture/check-workspace.mjs",
    "workflows:check": "node tools/architecture/check-workflows.mjs",
    "docs:check": "node tools/architecture/check-docs.mjs",
    "artifact:validate": "node tools/architecture/validate-artifact-contract.mjs",
    "secrets:check": "node tools/architecture/check-secrets.mjs",
    "phase0:check": "node tools/architecture/run-phase-0-gate.mjs",
    "phase1:format:check": "prettier --check packages/lexicon-contracts packages/ai-provider packages/lexicon-compiler services/vocabulary-importer/tsconfig.json tools/architecture/check-workspace.mjs tools/architecture/phase-1-clean-commit.mjs tools/architecture/prepare-phase-1-pilot.mjs tools/architecture/run-phase-1-gate.mjs tools/architecture/run-phase-1-pilot.mjs tools/architecture/run-phase-1-pilot.test.mjs",
    "phase1:check": "node tools/architecture/run-phase-1-gate.mjs",
    "phase1:pilot:prepare": "node tools/architecture/prepare-phase-1-pilot.mjs",
    "phase1:pilot": "node tools/architecture/run-phase-1-pilot.mjs",
    "harness:init": "pnpm --filter @sylis/harness run init -- --target ../..",
    "harness:check": "pnpm --filter @sylis/harness run check -- --target ../..",
    "harness:test": "pnpm --filter @sylis/harness test",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter ./apps/web run test:e2e --if-present",
    "db:generate": "pnpm --filter ./apps/api run db:generate",
    "db:push": "pnpm --filter ./apps/api run db:push",
    "db:migrate": "pnpm --filter ./apps/api run db:migrate",
    "db:seed": "pnpm --filter ./apps/api run db:seed",
    "db:studio": "pnpm --filter ./apps/api run db:studio",
    "db:reset": "pnpm --filter ./apps/api run db:reset",
    "commit": "cz",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "9.39.1",
    "@sylis/shared": "workspace:^",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "3.6.2",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}

model DictionaryImportRun {
  id           String    @id @default(uuid())
  source       String
  sourceCommit String
  checksum     String
  status       String
  scope        String    @default("all")
  selected     Int       @default(0)
  inserted     Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  relations    Int       @default(0)
  books        Int       @default(0)
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([source, startedAt])
}

model WordLexiconMetadata {
  id            String   @id @default(uuid())
  wordId        String   @unique
  source        String
  sourceCommit  String
  tags          String[]
  bncRank       Int?
  frequencyRank Int?
  oxford        Boolean  @default(false)
  collins       Int?
  exchange      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  word          Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([bncRank])
  @@index([frequencyRank])
}

model WordEnrichment {
  id             String           @id @default(uuid())
  wordId         String           @unique
  status         EnrichmentStatus @default(PENDING)
  contentVersion String
  attempts       Int              @default(0)
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  costCny        Decimal          @default(0) @db.Decimal(12, 6)
  lastError      String?
  lockedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  word           Word             @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model VocabularyEnrichmentRun {
  id               String           @id @default(uuid())
  scope            String
  status           EnrichmentStatus @default(PENDING)
  model            String
  contentVersion   String
  requested        Int              @default(0)
  processed        Int              @default(0)
  succeeded        Int              @default(0)
  failed           Int              @default(0)
  inputTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  costCny          Decimal          @default(0) @db.Decimal(12, 6)
  projectedCostCny Decimal?         @db.Decimal(12, 6)
  costCapCny       Decimal?         @db.Decimal(12, 6)
  error            String?
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?

  @@index([status, startedAt])
}

enum ContentSource {
  LEGACY
  ECDICT
  DERIVED
  AI
}

enum EnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

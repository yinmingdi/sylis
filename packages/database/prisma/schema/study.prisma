model PedagogicalMaterialMention {
  id                  String                                         @id @default(uuid()) @db.Uuid
  releaseId           String                                         @db.Uuid
  materialBlockId     String                                         @db.Uuid
  startOffset         Int
  endOffset           Int
  textBlock           PedagogicalMaterialTextBlock                   @relation(fields: [releaseId, materialBlockId], references: [releaseId, blockId], onDelete: Restrict)

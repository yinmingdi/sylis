enum ArticleDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ArticleType {
  STORY
  NEWS
  ESSAY
  CONVERSATION
}

enum ArticleLength {
  SHORT
  MEDIUM
  LONG
}

model Article {
  id          String            @id @default(cuid())
  title       String
  content     String
  wordCount   Int
  difficulty  ArticleDifficulty
  theme       String?
  articleType ArticleType
  length      ArticleLength
  usedWords   Json?
  userId      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("articles")
}

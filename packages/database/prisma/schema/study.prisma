  formTargets         PedagogicalMaterialMentionFormTarget[]
  senseTargets        PedagogicalMaterialMentionSenseTarget[]
  conceptTargets      PedagogicalMaterialMentionConceptTarget[]
  senseExampleTargets PedagogicalMaterialMentionSenseExampleTarget[]
  collocationTargets  PedagogicalMaterialMentionCollocationTarget[]
  frameTargets        PedagogicalMaterialMentionFrameTarget[]
  morphemeTargets     PedagogicalMaterialMentionMorphemeTarget[]

  @@unique([releaseId, id])
  @@unique([releaseId, materialBlockId, startOffset, endOffset])
}


    "@sylis/database": "workspace:*",
    "@sylis/lexicon-contracts": "workspace:*",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "pg": "8.16.3",
    "pg-copy-streams": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "@types/pg-copy-streams": "1.2.5",
    "tsdown": "0.22.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }

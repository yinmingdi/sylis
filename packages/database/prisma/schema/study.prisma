model PedagogicalMaterialTextBlock {
  releaseId   String                       @db.Uuid
  blockId     String                       @db.Uuid
  languageTag String
  text        String
  block       PedagogicalMaterialBlock     @relation(fields: [releaseId, blockId], references: [releaseId, id], onDelete: Restrict)

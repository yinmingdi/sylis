/**
 * Search and learning anchor. A Word is a searchable spelling; a Lexeme
 * below it represents a particular part of speech or homograph.
 */
model Word {
  id                 String                   @id @default(uuid())
  headword           String
  normalizedHeadword String                   @unique
  star               Int                      @default(0)
  lexicalForms       LexicalForm[]            @relation("IndexedWordForms")
  userWords          UserWord[]
  wordBooks          WordBook[]
  quizQuestions      QuizQuestion[]
  quizChoiceOptions  QuizChoiceOption[]
  dailyWordProgress  DailyWordProgress[]
  collectedWords     CollectedWord[]
  lexiconMetadata    WordLexiconMetadata[]
  enrichment         WordEnrichment?
  usageExamples      UsageExample[]
  collocations       Collocation[]
  media              WordMedia[]
  practiceQuestions  WordPracticeQuestion[]
  sourceRecords      LexiconSourceRecord[]
  lemmaLexemes       Lexeme[]                 @relation("LemmaWord")
  completeness       WordContentCompleteness?
  mnemonics          Mnemonic[]

  @@index([headword])
}

model Lexeme {
  id                String                 @id @default(uuid())
  lemmaWordId       String
  language          String                 @default("en")
  lexicalCategory   LexicalCategory
  homographNo       Int                    @default(1)
  displayOrder      Int                    @default(0)
  lemmaWord         Word                   @relation("LemmaWord", fields: [lemmaWordId], references: [id], onDelete: Cascade)
  forms             LexicalForm[]
  senses            LexicalSense[]
  examples          UsageExample[]
  collocations      Collocation[]
  practiceQuestions WordPracticeQuestion[]
  sourceRelations   LexemeRelation[]       @relation("SourceLexemeRelations")
  targetRelations   LexemeRelation[]       @relation("TargetLexemeRelations")
  semanticRelations SemanticRelation[]     @relation("SourceLexemeSemantics")
  targetSemantics   SemanticRelation[]     @relation("TargetLexemeSemantics")
  mnemonics         Mnemonic[]

  @@unique([lemmaWordId, lexicalCategory, homographNo])
  @@index([lexicalCategory])
}

model LexicalForm {
  id             String               @id @default(uuid())
  lexemeId       String
  indexedWordId  String?
  formType       LexicalFormType
  writtenForm    String
  normalizedForm String
  featureKey     String               @default("")
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  displayOrder   Int                  @default(0)
  lexeme         Lexeme               @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  indexedWord    Word?                @relation("IndexedWordForms", fields: [indexedWordId], references: [id], onDelete: SetNull)
  pronunciation  FormPronunciation[]
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([lexemeId, normalizedForm, featureKey, source, sourceVersion])
  @@index([indexedWordId])
  @@index([normalizedForm])
}

model FormPronunciation {
  id             String               @id @default(uuid())
  lexicalFormId  String
  region         PronunciationRegion
  ipa            String?
  audioUrl       String?
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  lexicalForm    LexicalForm          @relation(fields: [lexicalFormId], references: [id], onDelete: Cascade)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([lexicalFormId, region, source, sourceVersion])
}

model LexicalSense {
  id              String                 @id @default(uuid())
  lexemeId        String
  sourceRecordId  String?
  sourceSenseKey  String
  displayOrder    Int                    @default(0)
  grammarLabels   String[]               @default([])
  source          ContentSource
  sourceVersion   String
  trust           ContentTrust           @default(SOURCE_BACKED)
  confidence      Float?
  lexeme          Lexeme                 @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  glosses         SenseGloss[]
  examples        UsageExample[]
  collocations    Collocation[]
  semantics       SemanticRelation[]     @relation("SourceSenseSemantics")
  targetSemantics SemanticRelation[]     @relation("TargetSenseSemantics")
  mnemonics       Mnemonic[]
  questions       WordPracticeQuestion[]
  sourceRecord    LexiconSourceRecord?   @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([sourceRecordId, sourceSenseKey])
  @@index([lexemeId, displayOrder])
}

model SenseGloss {
  id             String               @id @default(uuid())
  senseId        String
  languageTag    String
  text           String
  normalized     String
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  isExperimental Boolean              @default(false)
  sense          LexicalSense         @relation(fields: [senseId], references: [id], onDelete: Cascade)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([senseId, languageTag, normalized])
}

model UsageExample {
  id             String               @id @default(uuid())
  wordId         String
  lexemeId       String?
  senseId        String?
  kind           ExampleKind
  sentenceEn     String
  sentenceCn     String?
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  isExperimental Boolean              @default(false)
  word           Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lexeme         Lexeme?              @relation(fields: [lexemeId], references: [id], onDelete: SetNull)
  sense          LexicalSense?        @relation(fields: [senseId], references: [id], onDelete: SetNull)
  citation       ExampleCitation?
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([wordId, sentenceEn, source, sourceVersion])
  @@index([senseId])
}

model ExampleCitation {
  id             String               @id @default(uuid())
  exampleId      String               @unique
  sourceRecordId String?
  paper          String?
  level          String?
  year           String?
  examType       String?
  verified       Boolean              @default(false)
  example        UsageExample         @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@index([level, year])
}

model Collocation {
  id             String               @id @default(uuid())
  wordId         String
  lexemeId       String?
  senseId        String?
  phraseText     String
  phraseCn       String?
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  isExperimental Boolean              @default(false)
  word           Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lexeme         Lexeme?              @relation(fields: [lexemeId], references: [id], onDelete: SetNull)
  sense          LexicalSense?        @relation(fields: [senseId], references: [id], onDelete: SetNull)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([wordId, phraseText, source, sourceVersion])
}

model SemanticRelation {
  id             String               @id @default(uuid())
  sourceLexemeId String
  sourceSenseId  String?
  targetLexemeId String?
  targetSenseId  String?
  targetText     String
  targetMeaning  String?
  relationType   SemanticRelationType
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  isExperimental Boolean              @default(false)
  sourceLexeme   Lexeme               @relation("SourceLexemeSemantics", fields: [sourceLexemeId], references: [id], onDelete: Cascade)
  sourceSense    LexicalSense?        @relation("SourceSenseSemantics", fields: [sourceSenseId], references: [id], onDelete: SetNull)
  targetSense    LexicalSense?        @relation("TargetSenseSemantics", fields: [targetSenseId], references: [id], onDelete: SetNull)
  targetLexeme   Lexeme?              @relation("TargetLexemeSemantics", fields: [targetLexemeId], references: [id], onDelete: SetNull)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([sourceLexemeId, sourceSenseId, relationType, targetText, source, sourceVersion])
  @@index([targetLexemeId])
}

model LexemeRelation {
  id             String               @id @default(uuid())
  sourceLexemeId String
  targetLexemeId String?
  targetText     String
  targetMeaning  String?
  relationType   LexemeRelationType
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  isExperimental Boolean              @default(false)
  sourceLexeme   Lexeme               @relation("SourceLexemeRelations", fields: [sourceLexemeId], references: [id], onDelete: Cascade)
  targetLexeme   Lexeme?              @relation("TargetLexemeRelations", fields: [targetLexemeId], references: [id], onDelete: SetNull)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([sourceLexemeId, relationType, targetText, source, sourceVersion])
}

model Mnemonic {
  id             String               @id @default(uuid())
  wordId         String
  lexemeId       String?
  senseId        String?
  text           String
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  isExperimental Boolean              @default(false)
  word           Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lexeme         Lexeme?              @relation(fields: [lexemeId], references: [id], onDelete: SetNull)
  sense          LexicalSense?        @relation(fields: [senseId], references: [id], onDelete: SetNull)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([wordId, text, source, sourceVersion])
}

model WordMedia {
  id             String               @id @default(uuid())
  wordId         String
  mediaType      MediaType
  uri            String
  altText        String?
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  word           Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([wordId, mediaType, uri, source, sourceVersion])
}

model WordPracticeQuestion {
  id             String               @id @default(uuid())
  wordId         String
  lexemeId       String?
  senseId        String?
  kind           PracticeQuestionKind
  stem           String
  explanation    String?
  correctIndex   Int?
  sourceRecordId String?
  source         ContentSource
  sourceVersion  String
  trust          ContentTrust         @default(SOURCE_BACKED)
  isExperimental Boolean              @default(false)
  word           Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lexeme         Lexeme?              @relation(fields: [lexemeId], references: [id], onDelete: SetNull)
  sense          LexicalSense?        @relation(fields: [senseId], references: [id], onDelete: SetNull)
  choices        WordPracticeChoice[]
  sourceRecord   LexiconSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([wordId, stem, source, sourceVersion])
}

model WordPracticeChoice {
  id          String               @id @default(uuid())
  questionId  String
  choiceIndex Int
  text        String
  question    WordPracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, choiceIndex])
}

model WordContentCompleteness {
  id             String   @id @default(uuid())
  wordId         String   @unique
  profile        String
  status         String
  missingFields  String[] @default([])
  fieldStates    Json
  contentVersion String
  updatedAt      DateTime @updatedAt
  word           Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

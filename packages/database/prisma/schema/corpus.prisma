model CorpusDataset {
  id          String                 @id @default(uuid()) @db.Uuid
  key         String                 @unique
  name        String
  languageTag String
  versions    CorpusDatasetVersion[]
}

model CorpusDatasetVersion {
  id           String                   @id @default(uuid()) @db.Uuid
  datasetId    String                   @db.Uuid
  version      String
  checksum     String
  tokenCount   BigInt
  provenanceId String                   @db.Uuid
  dataset      CorpusDataset            @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  provenance   Provenance               @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  observations FrequencyObservation[]
  attestations Attestation[]
  collocations CollocationObservation[]

  @@unique([datasetId, version])
}

model Attestation {
  id               String               @id @default(uuid()) @db.Uuid
  releaseId        String               @db.Uuid
  datasetVersionId String               @db.Uuid
  targetKind       String
  targetId         String               @db.Uuid
  documentRef      String
  offset           Int
  offsetUnit       String
  surfaceText      String
  sourceRecordId   String               @db.Uuid
  provenanceId     String               @db.Uuid
  datasetVersion   CorpusDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  sourceRecord     SourceRecord         @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  provenance       Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, datasetVersionId, documentRef, offset, targetKind, targetId])
}

model CollocationObservation {
  id               String               @id @default(uuid()) @db.Uuid
  releaseId        String               @db.Uuid
  datasetVersionId String               @db.Uuid
  collocationId    String               @db.Uuid
  measureCode      String
  score            Float
  window           Int
  algorithmVersion String
  provenanceId     String               @db.Uuid
  datasetVersion   CorpusDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  provenance       Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, datasetVersionId, collocationId, measureCode, algorithmVersion])
}

model FrequencyObservation {
  id                  String               @id @default(uuid()) @db.Uuid
  releaseId           String               @db.Uuid
  datasetVersionId    String               @db.Uuid
  targetKind          String
  targetId            String               @db.Uuid
  count               BigInt?
  normalizedFrequency Decimal?             @db.Decimal(20, 10)
  rank                Int?
  unit                String
  algorithmVersion    String
  provenanceId        String               @db.Uuid
  datasetVersion      CorpusDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  provenance          Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, datasetVersionId, targetKind, targetId, unit])
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@sylis/docs",
  "projectType": "library",
  "sourceRoot": "docs/overview",
  "tags": ["type:docs", "scope:platform", "runtime:docs"],
  "targets": {
    "docs:build": { "outputs": ["{projectRoot}/.vitepress/dist"] },
    "docs:dev": { "continuous": true, "cache": false },
    "docs:preview": { "continuous": true, "cache": false },
    "typedocs:build": { "outputs": ["{projectRoot}/apis"] }
  }
}

model TranslationRelation {
  id              String               @id @default(uuid()) @db.Uuid
  releaseId       String               @db.Uuid
  sourceSenseId   String               @db.Uuid
  targetSenseId   String               @db.Uuid
  translationType String
  provenanceId    String               @db.Uuid
  source          LexicalSenseRevision @relation("TranslationRelationSource", fields: [releaseId, sourceSenseId], references: [releaseId, senseId], onDelete: Restrict)
  target          LexicalSenseRevision @relation("TranslationRelationTarget", fields: [releaseId, targetSenseId], references: [releaseId, senseId], onDelete: Restrict)
  provenance      Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, sourceSenseId, targetSenseId, translationType])
}

model EntryLineage {
  id            String             @id @default(uuid()) @db.Uuid
  releaseId     String             @db.Uuid
  sourceEntryId String             @db.Uuid
  targetEntryId String             @db.Uuid
  lineageType   LexicalLineageType
  provenanceId  String             @db.Uuid
  release       LexiconRelease     @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  source        LexicalEntry       @relation("EntryLineageSource", fields: [sourceEntryId], references: [id], onDelete: Restrict)
  target        LexicalEntry       @relation("EntryLineageTarget", fields: [targetEntryId], references: [id], onDelete: Restrict)
  provenance    Provenance         @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, sourceEntryId, targetEntryId, lineageType])
}


PORT=3002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sylis
JOB_POLL_INTERVAL_MS=5000
JOB_LEASE_DURATION_MS=60000
JOB_CHECKPOINT_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LEXICON_RUNNER_WORK_ROOT=/data/lexicon-compiler/work
LEXICON_ARTIFACT_ROOT=/data/lexicon-compiler/artifacts
LEXICON_ARTIFACT_ALLOW_FILE=true

# Optional. Required only when a build request has modelPolicy.enabled=true.
# Compiler AI uses a separate credential and encrypted local cache key.
LEXICON_AI_API_KEY=replace-with-compiler-ai-key
LEXICON_AI_BASE_URL=https://api.deepseek.com
LEXICON_AI_STRICT_BASE_URL=https://api.deepseek.com
LEXICON_AI_MODEL=deepseek-v4-flash
LEXICON_AI_CACHE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LEXICON_AI_MAX_ATTEMPTS=5
LEXICON_AI_RETRY_BASE_MS=500
LEXICON_AI_RETRY_MAX_MS=30000

# S3-compatible immutable artifact publication. HTTPS is required.
AWS_ENDPOINT_URL=https://storage.example.com
AWS_ENDPOINT_IP=
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET_NAME=sylis-lexicon
AWS_S3_URL_STYLE=path
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key

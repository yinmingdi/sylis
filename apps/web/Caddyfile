:{$PORT:8080} {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }

  handle /health {
    respond "ok" 200
  }

  handle_path /api/* {
    reverse_proxy {$API_UPSTREAM:http://api.railway.internal:3000}
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}

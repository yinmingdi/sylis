model ReadingGeneration {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @db.Uuid
  jobId               String          @unique @db.Uuid
  documentId          String          @db.Uuid
  requestedDifficulty String
  constraints         Json
  resultRevisionId    String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                 BackgroundJob   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  document            ReadingDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
}

model ModelInvocation {
  id             String         @id @default(uuid()) @db.Uuid
  jobId          String?        @db.Uuid
  capability     String
  provider       String
  requestedModel String
  resolvedModel  String?
  promptVersion  String
  schemaVersion  String?
  idempotencyKey String         @unique
  inputHash      String
  outputHash     String?
  inputTokens    Int?
  outputTokens   Int?
  costMicros     BigInt?
  status         String
  startedAt      DateTime       @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?      @db.Timestamptz(3)
  job            BackgroundJob? @relation(fields: [jobId], references: [id], onDelete: Restrict)
}

model AIUsageLedger {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  capability     String
  scope          String
  windowKey      String
  entryType      String
  units          BigInt
  costMicros     BigInt
  currency       String   @default("USD")
  idempotencyKey String   @unique
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AIQuotaPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  scope         String
  capability    String
  window        String
  limitUnits    BigInt
  limitMicros   BigInt
  currency      String    @default("USD")
  effectiveFrom DateTime  @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  version       String

  @@unique([scope, capability, version])
}

model RuntimeFeatureControl {
  key             String   @id
  enabled         Boolean
  reason          String
  version         Int      @default(1)
  updatedByUserId String   @db.Uuid
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

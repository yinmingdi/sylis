{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/backends/api/Dockerfile",
    "watchPatterns": [
      "/apps/backends/api/**",
      "/packages/agent-contracts/**",
      "/packages/database/**",
      "/packages/job-contracts/**",
      "/packages/utils/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "DATABASE_URL=\"$DATABASE_OWNER_URL\" sh -c 'cd node_modules/@sylis/database && node dist/operations/install-database.js'",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

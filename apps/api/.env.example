# Local development only. Railway injects these values per environment.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sylis
REDIS_URL=redis://localhost:6379

# Generate a unique random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=30d

# Official DeepSeek configuration. Never expose these keys to Vite.
AI_API_KEY=replace-with-an-ai-provider-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_ENRICHMENT_ENABLED=false
# Configure only on the manual vocabulary-enricher Railway service.
AI_ENRICHMENT_API_KEY=replace-with-a-separate-enrichment-key

MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=replace-with-smtp-user
MAILER_PASS=replace-with-smtp-app-password
MAILER_FROM=Sylis <no-reply@example.com>

# Optional. Configure both credentials together.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sylis/1.0

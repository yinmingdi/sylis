{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @sylis/api prisma:generate && pnpm --filter @sylis/vocabulary-importer build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @sylis/vocabulary-importer start --scope all",
    "restartPolicyType": "NEVER"
  }
}

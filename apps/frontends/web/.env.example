# The browser uses same-origin /api requests in every environment.
# Never add AI keys, database URLs, tokens, or other secrets to VITE_* variables.

# Local Vite proxy only. SYLIS_API_PROXY_ORIGIN must match the API service's
# PUBLIC_ORIGIN so authenticated mutations pass the server-side CSRF origin check.
SYLIS_API_PROXY_TARGET=http://localhost:3000
SYLIS_API_PROXY_ORIGIN=http://localhost:5178
SYLIS_AGENT_API_PROXY_TARGET=http://localhost:3200

model ProficiencyFramework {
  id              String                        @id @default(uuid()) @db.Uuid
  key             String                        @unique
  name            String
  sourceDatasetId String                        @db.Uuid
  sourceDataset   SourceDataset                 @relation(fields: [sourceDatasetId], references: [id], onDelete: Restrict)
  versions        ProficiencyFrameworkVersion[]
}

model ProficiencyFrameworkVersion {
  id                     String               @id @default(uuid()) @db.Uuid
  frameworkId            String               @db.Uuid
  version                String
  namespace              String
  sourceDatasetVersionId String               @db.Uuid
  framework              ProficiencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  sourceDatasetVersion   SourceDatasetVersion @relation(fields: [sourceDatasetVersionId], references: [id], onDelete: Restrict)
  levels                 ProficiencyLevel[]

  @@unique([frameworkId, version])
}

model ProficiencyLevel {
  id                   String                                @id @default(uuid()) @db.Uuid
  versionId            String                                @db.Uuid
  code                 String
  label                String
  rank                 Int
  version              ProficiencyFrameworkVersion           @relation(fields: [versionId], references: [id], onDelete: Restrict)
  headwordClaims       ProficiencyHeadwordClaim[]
  entryClaims          ProficiencyEntryClaim[]
  senseClaims          ProficiencySenseClaim[]
  assessmentScopeRules AssessmentProficiencyLevelScopeRule[]

  @@unique([versionId, code])
  @@unique([versionId, rank])
}

model ProficiencyHeadwordClaim {
  id               String               @id @default(uuid()) @db.Uuid
  releaseId        String               @db.Uuid
  levelId          String               @db.Uuid
  headwordId       String               @db.Uuid
  claimType        ProficiencyClaimType
  provenanceId     String               @db.Uuid
  level            ProficiencyLevel     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  headwordRevision HeadwordRevision     @relation(fields: [releaseId, headwordId], references: [releaseId, headwordId], onDelete: Restrict)
  provenance       Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, levelId, headwordId, claimType])
}

model ProficiencyEntryClaim {
  id            String               @id @default(uuid()) @db.Uuid
  releaseId     String               @db.Uuid
  levelId       String               @db.Uuid
  entryId       String               @db.Uuid
  claimType     ProficiencyClaimType
  provenanceId  String               @db.Uuid
  level         ProficiencyLevel     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  entryRevision LexicalEntryRevision @relation(fields: [releaseId, entryId], references: [releaseId, entryId], onDelete: Restrict)
  provenance    Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, levelId, entryId, claimType])
}

model ProficiencySenseClaim {
  id            String               @id @default(uuid()) @db.Uuid
  releaseId     String               @db.Uuid
  levelId       String               @db.Uuid
  senseId       String               @db.Uuid
  claimType     ProficiencyClaimType
  provenanceId  String               @db.Uuid
  level         ProficiencyLevel     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  senseRevision LexicalSenseRevision @relation(fields: [releaseId, senseId], references: [releaseId, senseId], onDelete: Restrict)
  provenance    Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, levelId, senseId, claimType])
}

model LearningObjective {
  id            String                      @id @default(uuid()) @db.Uuid
  lexiconId     String                      @db.Uuid
  identityKey   String
  revisions     LearningObjectiveRevision[]
  memory        UserObjectiveMemoryState[]
  exerciseItems ExerciseItem[]

  @@unique([lexiconId, identityKey])
}

model LearningObjectiveRevision {
  id                       String                                            @id @default(uuid()) @db.Uuid
  releaseId                String                                            @db.Uuid
  objectiveId              String                                            @db.Uuid
  knowledgeFacet           KnowledgeFacet
  retrievalDirection       RetrievalDirection
  status                   RevisionStatus                                    @default(PUBLISHED)
  contentHash              String
  provenanceId             String                                            @db.Uuid
  release                  LexiconRelease                                    @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  objective                LearningObjective                                 @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  provenance               Provenance                                        @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  hints                    LearningObjectiveHint[]
  senseSubjects            LearningObjectiveSenseSubject[]
  formSubjects             LearningObjectiveFormSubject[]
  collocationSubjects      LearningObjectiveCollocationSubject[]
  frameSubjects            LearningObjectiveFrameSubject[]
  exampleSubjects          LearningObjectiveExampleSubject[]
  pedagogicalTargets       PedagogicalMaterialLearningObjectiveTarget[]
  profileTargets           ContentProfileEvaluationLearningObjectiveTarget[]
  exerciseRevisions        ExerciseRevision[]
  memory                   UserObjectiveMemoryState[]
  reviewEvents             ReviewEvent[]
  planItems                DailyStudyPlanItem[]
  readingAnnotationTargets LexicalAnnotationObjectiveTarget[]
  readingTargets           ReadingTarget[]

  @@unique([releaseId, objectiveId])
  @@unique([releaseId, id])
  @@unique([releaseId, objectiveId, id])
}

model LearningObjectiveSenseSubject {
  releaseId           String                    @db.Uuid
  objectiveRevisionId String                    @db.Uuid
  subjectRole         LearningTargetRole
  senseId             String                    @db.Uuid
  objectiveRevision   LearningObjectiveRevision @relation(fields: [releaseId, objectiveRevisionId], references: [releaseId, id], onDelete: Restrict)

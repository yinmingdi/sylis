model EntryExternalIdentifier {
  id                 String                     @id @default(uuid()) @db.Uuid
  releaseId          String                     @db.Uuid
  entryId            String                     @db.Uuid
  namespaceVersionId String                     @db.Uuid
  externalId         String
  uri                String?
  provenanceId       String                     @db.Uuid
  release            LexiconRelease             @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  entry              LexicalEntry               @relation(fields: [entryId], references: [id], onDelete: Restrict)
  namespace          VocabularyNamespaceVersion @relation(fields: [namespaceVersionId], references: [id], onDelete: Restrict)
  provenance         Provenance                 @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, entryId, namespaceVersionId, externalId])
}


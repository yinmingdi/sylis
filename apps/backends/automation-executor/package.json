    "@sylis/database": "workspace:*",
    "@sylis/job-contracts": "workspace:*",
    "@sylis/job-runtime": "workspace:*",
    "@sylis/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

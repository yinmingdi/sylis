# Local development only. Railway injects production values per service.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sylis
# Railway API pre-deploy only; use the schema owner, never the runtime role.
DATABASE_OWNER_URL=postgresql://postgres:postgres@localhost:5432/sylis
REDIS_URL=redis://localhost:6379

# Public browser origins and WebAuthn relying-party identity.
PUBLIC_ORIGIN=http://localhost:5178
ADMIN_ORIGIN=http://localhost:5174
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sylis
COOKIE_SECURE=false
SESSION_TTL_SECONDS=2592000
USER_SESSION_IDLE_TTL_SECONDS=86400
ADMIN_SESSION_IDLE_TTL_SECONDS=1800
USER_CONTENT_RETENTION_MS=2592000000

# Generate independent random values. Never reuse one key for two purposes.
SESSION_HASH_KEY=replace-with-at-least-32-random-characters
CSRF_SIGNING_KEY=replace-with-at-least-32-random-characters
REGISTRATION_SIGNING_KEY=replace-with-at-least-32-random-characters
SERVICE_GRANT_TOKENS_JSON={"admin-api":"replace-admin-api-token-32chars","agent-api":"replace-agent-api-token-32chars","agent-executor":"replace-agent-executor-token-32chars","asset-processor":"replace-asset-processor-token-32chars","automation-executor":"replace-automation-executor-token-32chars"}
AGENT_API_URL=http://localhost:3200
AGENT_API_SERVICE_TOKEN=replace-api-token-32-random-characters
MODEL_GATEWAY_URL=http://localhost:3300
MODEL_GATEWAY_SERVICE_TOKEN=replace-api-token-32-random-characters

# API deployment-readiness gateway. On Railway, construct each value from the
# target service's RAILWAY_PRIVATE_DOMAIN and explicitly configured PORT.
DEPLOYMENT_ADMIN_API_READINESS_URL=http://localhost:3100/health/ready
DEPLOYMENT_AGENT_API_READINESS_URL=http://localhost:3200/health/ready
DEPLOYMENT_MODEL_GATEWAY_READINESS_URL=http://localhost:3300/health/ready
DEPLOYMENT_AGENT_EXECUTOR_READINESS_URL=http://localhost:3400/ready
DEPLOYMENT_AGENT_EVALUATOR_READINESS_URL=http://localhost:3500/ready
DEPLOYMENT_ASSET_PROCESSOR_READINESS_URL=http://localhost:3600/ready
DEPLOYMENT_AUTOMATION_EXECUTOR_READINESS_URL=http://localhost:3700/ready
DEPLOYMENT_LEXICON_BUILDER_READINESS_URL=http://localhost:3800/ready
DEPLOYMENT_LEXICON_PUBLISHER_READINESS_URL=http://localhost:3900/ready

CONTENT_ENCRYPTION_KEYS_JSON={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
CONTENT_ENCRYPTION_ACTIVE_KEY_VERSION=v1

# Optional deployment synthetic accounts. Configure all five together in
# Railway API sealed variables and the matching GitHub environment secrets.
SYLIS_SYNTHETIC_USER_EMAIL=
SYLIS_SYNTHETIC_USER_PASSWORD=
SYLIS_SYNTHETIC_ADMIN_EMAIL=
SYLIS_SYNTHETIC_ADMIN_PASSWORD=
SYLIS_SYNTHETIC_ADMIN_TOTP_SECRET=

# Optional SMTP delivery. Leave all values empty to disable email delivery locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sylis <no-reply@example.com>

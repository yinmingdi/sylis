model CorpusDataset {
  id          String                 @id @default(uuid()) @db.Uuid
  key         String                 @unique
  name        String
  languageTag String
  versions    CorpusDatasetVersion[]
}

model CorpusDatasetVersion {
  id                         String                      @id @default(uuid()) @db.Uuid
  datasetId                  String                      @db.Uuid
  version                    String
  checksum                   String
  tokenCount                 BigInt
  provenanceId               String                      @db.Uuid
  dataset                    CorpusDataset               @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  provenance                 Provenance                  @relation(fields: [provenanceId], references: [id], onDelete: Restrict)
  entryFrequencyObservations EntryFrequencyObservation[]
  formFrequencyObservations  FormFrequencyObservation[]
  senseFrequencyObservations SenseFrequencyObservation[]
  entryAttestations          EntryAttestation[]
  formAttestations           FormAttestation[]
  senseAttestations          SenseAttestation[]
  collocations               CollocationObservation[]

  @@unique([datasetId, version])
}

model EntryAttestation {
  id               String               @id @default(uuid()) @db.Uuid
  releaseId        String               @db.Uuid
  datasetVersionId String               @db.Uuid
  entryId          String               @db.Uuid
  documentRef      String
  offset           Int
  offsetUnit       TextOffsetUnit
  surfaceText      String
  sourceRecordId   String               @db.Uuid
  provenanceId     String               @db.Uuid
  datasetVersion   CorpusDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  entry            LexicalEntryRevision @relation(fields: [releaseId, entryId], references: [releaseId, entryId], onDelete: Restrict)
  sourceRecord     SourceRecord         @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  provenance       Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, datasetVersionId, documentRef, offset, entryId])
}

model FormAttestation {
  id               String               @id @default(uuid()) @db.Uuid
  releaseId        String               @db.Uuid
  datasetVersionId String               @db.Uuid
  formId           String               @db.Uuid
  documentRef      String
  offset           Int
  offsetUnit       TextOffsetUnit
  surfaceText      String
  sourceRecordId   String               @db.Uuid
  provenanceId     String               @db.Uuid
  datasetVersion   CorpusDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  form             LexicalForm          @relation(fields: [releaseId, formId], references: [releaseId, id], onDelete: Restrict)
  sourceRecord     SourceRecord         @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  provenance       Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, datasetVersionId, documentRef, offset, formId])
}

model SenseAttestation {
  id               String               @id @default(uuid()) @db.Uuid
  releaseId        String               @db.Uuid
  datasetVersionId String               @db.Uuid
  senseId          String               @db.Uuid
  documentRef      String
  offset           Int
  offsetUnit       TextOffsetUnit
  surfaceText      String
  sourceRecordId   String               @db.Uuid
  provenanceId     String               @db.Uuid
  datasetVersion   CorpusDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  sense            LexicalSenseRevision @relation(fields: [releaseId, senseId], references: [releaseId, senseId], onDelete: Restrict)
  sourceRecord     SourceRecord         @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  provenance       Provenance           @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, datasetVersionId, documentRef, offset, senseId])

{
  "components": {
    "schemas": {
      "AddNotebookItemDto": {
        "properties": {
          "note": {
            "maxLength": 2000,
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "target": {
            "$ref": "#/components/schemas/LexicalTargetDto"
          }
        },
        "required": ["target"],
        "type": "object"
      },
      "ConsentRecordDto": {
        "properties": {
          "decision": {
            "type": "object"
          },
          "policyVersion": {
            "maxLength": 64,
            "type": "string"
          },
          "purpose": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": ["purpose", "policyVersion", "decision"],
        "type": "object"
      },
      "CreateAssessmentSessionDto": {
        "properties": {
          "blueprintRevisionId": {
            "type": "string"
          }
        },
        "required": ["blueprintRevisionId"],
        "type": "object"
      },
      "CreateEnrollmentDto": {
        "properties": {
          "bookId": {
            "format": "uuid",
            "type": "string"
          },
          "dailyNewLimit": {
            "maximum": 200,
            "minimum": 1,
            "type": "number"
          },
          "editionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["bookId", "editionId", "dailyNewLimit"],
        "type": "object"
      },
      "CreateGrammarDiagnosisDto": {
        "properties": {
          "consentRecordId": {
            "type": "string"
          },
          "languageTag": {
            "type": "string"
          },
          "text": {
            "maxLength": 12000,
            "type": "string"
          }
        },
        "required": ["text", "languageTag", "consentRecordId"],
        "type": "object"
      },
      "CreateNotebookDto": {
        "properties": {
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "title": {
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": ["title"],
        "type": "object"
      },
      "CreateReadingGenerationDto": {
        "properties": {
          "consentRecordId": {
            "type": "string"
          },
          "constraints": {
            "type": "object"
          },
          "difficulty": {
            "type": "string"
          }
        },
        "required": ["difficulty", "consentRecordId"],
        "type": "object"
      },
      "CreateStudyAttemptDto": {
        "properties": {
          "planItemId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["planItemId"],
        "type": "object"
      },
      "CreateTutorMessageDto": {
        "properties": {
          "consentRecordId": {
            "type": "string"
          },
          "content": {
            "maxLength": 8000,
            "type": "string"
          },
          "contextRefs": {
            "items": {
              "$ref": "#/components/schemas/TutorContextRefDto"
            },
            "type": "array"
          }
        },
        "required": ["content", "consentRecordId", "contextRefs"],
        "type": "object"
      },
      "CreateTutorSessionDto": {
        "properties": {
          "title": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "type": "object"
      },
      "DataExportDto": {
        "properties": {
          "scope": {
            "type": "object"
          }
        },
        "required": ["scope"],
        "type": "object"
      },
      "LexicalTargetDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "object"
          }
        },
        "required": ["kind", "id"],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "MigrateEnrollmentDto": {
        "properties": {
          "confirm": {
            "default": false,
            "type": "object"
          },
          "editionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["editionId", "confirm"],
        "type": "object"
      },
      "Object": {
        "properties": {},
        "type": "object"
      },
      "RecordReadingActivityDto": {
        "properties": {
          "documentId": {
            "type": "string"
          },
          "eventKind": {
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "number"
          },
          "progress": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "revisionId": {
            "type": "string"
          }
        },
        "required": ["documentId", "eventKind"],
        "type": "object"
      },
      "RegisterDto": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          },
          "timezone": {
            "maxLength": 35,
            "minLength": 2,
            "type": "string"
          },
          "token": {
            "maxLength": 2048,
            "minLength": 40,
            "type": "string"
          }
        },
        "required": ["token", "password", "timezone"],
        "type": "object"
      },
      "RegistrationChallengeDto": {
        "properties": {
          "email": {
            "example": "learner@example.com",
            "format": "email",
            "type": "string"
          }
        },
        "required": ["email"],
        "type": "object"
      },
      "ResolveSelectionDto": {
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": ["text"],
        "type": "object"
      },
      "SaveReadingDto": {
        "properties": {
          "documentId": {
            "type": "string"
          },
          "releaseId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "targetKind": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SubmitAssessmentResponseDto": {
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "response": {
            "$ref": "#/components/schemas/SubmitExerciseResponseDto"
          }
        },
        "required": ["attemptId", "response"],
        "type": "object"
      },
      "SubmitExerciseResponseDto": {
        "properties": {
          "choiceIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          "consentRecordId": {
            "format": "uuid",
            "type": "string"
          },
          "responseKind": {
            "type": "object"
          },
          "selfReported": {
            "type": "boolean"
          },
          "text": {
            "maxLength": 10000,
            "type": "string"
          }
        },
        "required": ["responseKind"],
        "type": "object"
      },
      "SubmitReviewDto": {
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "rating": {
            "maximum": 4,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": ["attemptId", "rating"],
        "type": "object"
      },
      "TotpCodeDto": {
        "properties": {
          "code": {
            "maxLength": 6,
            "minLength": 6,
            "type": "string"
          }
        },
        "required": ["code"],
        "type": "object"
      },
      "TutorContextRefDto": {
        "properties": {
          "releaseId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "targetKind": {
            "type": "string"
          }
        },
        "required": ["targetKind", "targetId"],
        "type": "object"
      },
      "UpdateEnrollmentDto": {
        "properties": {
          "dailyNewLimit": {
            "maximum": 200,
            "minimum": 1,
            "type": "number"
          }
        },
        "type": "object"
      },
      "UpdateNotebookDto": {
        "properties": {
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "title": {
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": ["title"],
        "type": "object"
      },
      "UpdateNotebookItemDto": {
        "properties": {
          "note": {
            "maxLength": 2000,
            "type": "string"
          },
          "position": {
            "minimum": 0,
            "type": "number"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "UpdateUserDto": {
        "properties": {
          "locale": {
            "maxLength": 35,
            "minLength": 2,
            "type": "string"
          },
          "timezone": {
            "maxLength": 35,
            "minLength": 2,
            "type": "string"
          }
        },
        "required": ["timezone", "locale"],
        "type": "object"
      },
      "WebAuthnEnrollmentDto": {
        "properties": {
          "challengeId": {
            "maxLength": 36,
            "minLength": 36,
            "type": "string"
          },
          "label": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "response": {
            "type": "object"
          }
        },
        "required": ["challengeId", "label", "response"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "sylis_session": {
        "in": "cookie",
        "name": "sylis_session",
        "type": "apiKey"
      }
    }
  },
  "info": {

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @sylis/utils build && pnpm --filter @sylis/api prisma:generate && pnpm --filter @sylis/api build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @sylis/api exec prisma migrate deploy",
    "startCommand": "pnpm --filter @sylis/api start:prod",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

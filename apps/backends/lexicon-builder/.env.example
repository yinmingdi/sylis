PORT=3800
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sylis
ADMIN_API_URL=http://localhost:3100
MODEL_GATEWAY_URL=http://localhost:3300
SERVICE_GRANT_TOKEN=replace-lexicon-builder-token-32chars
JOB_POLL_INTERVAL_MS=5000
LEXICON_BUILDER_WORK_ROOT=/data/lexicon-builder/work
LEXICON_ARTIFACT_ROOT=/data/lexicon-builder/artifacts
LEXICON_AI_ENABLED=false
AWS_ENDPOINT_URL=https://replace-with-private-s3-endpoint
AWS_ENDPOINT_ALLOW_INSECURE=false
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET_NAME=sylis-lexicon
AWS_S3_URL_STYLE=virtual
AWS_ACCESS_KEY_ID=replace-with-lexicon-writer-access-key
AWS_SECRET_ACCESS_KEY=replace-with-lexicon-writer-secret-key

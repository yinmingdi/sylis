model OutboxEvent {
  id              String    @id @default(uuid()) @db.Uuid
  aggregateType   String
  aggregateId     String    @db.Uuid
  eventType       String
  eventVersion    String
  payload         Json
  occurredAt      DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt     DateTime? @db.Timestamptz(3)
  publishAttempts Int       @default(0)
  nextAttemptAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastErrorCode   String?

  @@index([publishedAt, nextAttemptAt])
}

model IdempotencyRecord {
  id              String         @id @default(uuid()) @db.Uuid
  actorId         String         @db.Uuid
  operation       String
  key             String
  requestHash     String
  responseRef     String
  statusCode      Int
  agentProposalId String?        @unique @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime       @db.Timestamptz(3)
  agentProposal   AgentProposal? @relation(fields: [agentProposalId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
  @@index([expiresAt])
}

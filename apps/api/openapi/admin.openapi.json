{
  "components": {
    "schemas": {
      "AdminChallengeDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "AdminMfaAssertionDto": {
        "properties": {
          "challengeToken": {
            "maxLength": 256,
            "minLength": 20,
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "method": {
            "type": "object"
          },
          "response": {
            "type": "object"
          }
        },
        "required": ["challengeToken", "method"],
        "type": "object"
      },
      "AdminSessionDto": {
        "properties": {
          "challengeToken": {
            "maxLength": 256,
            "minLength": 20,
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "method": {
            "type": "object"
          },
          "response": {
            "type": "object"
          }
        },
        "required": ["challengeToken", "method"],
        "type": "object"
      },
      "ApprovalDecisionDto": {
        "properties": {
          "decision": {
            "type": "object"
          },
          "reason": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": ["reason", "decision"],
        "type": "object"
      },
      "ApprovalReasonDto": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": ["reason"],
        "type": "object"
      },
      "CompilerModelPolicyDto": {
        "properties": {
          "cacheHitUsdPerMillion": {
            "maxLength": 32,
            "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,6})?$",
            "type": "string"
          },
          "concurrency": {
            "maximum": 16,
            "minimum": 1,
            "type": "number"
          },
          "enabled": {
            "type": "boolean"
          },
          "inputUsdPerMillion": {
            "maxLength": 32,
            "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,6})?$",
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "modelPolicyVersion": {
            "type": "string"
          },
          "outputUsdPerMillion": {
            "maxLength": 32,
            "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,6})?$",
            "type": "string"
          },
          "promptVersion": {
            "type": "string"
          },
          "provider": {
            "enum": ["deepseek"],
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          }
        },
        "required": ["enabled"],
        "type": "object"
      },
      "CreateBuildRunDto": {
        "properties": {
          "budgetMicros": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "number"
          },
          "compileProfile": {
            "enum": ["pilot-200", "core-20000"],
            "type": "string"
          },
          "manifestHash": {
            "type": "string"
          },
          "manifestUri": {
            "type": "string"
          },
          "modelPolicy": {
            "$ref": "#/components/schemas/CompilerModelPolicyDto"
          }
        },
        "required": [
          "compileProfile",
          "manifestUri",
          "manifestHash",
          "budgetMicros",
          "modelPolicy"
        ],
        "type": "object"
      },
      "CreateImportJobDto": {
        "properties": {
          "artifactHash": {
            "type": "string"
          },
          "artifactUri": {
            "type": "string"
          }
        },
        "required": ["artifactUri", "artifactHash"],
        "type": "object"
      },
      "CreateSourceSynchronizationDto": {
        "properties": {
          "sourceKind": {
            "type": "string"
          }
        },
        "required": ["sourceKind"],
        "type": "object"
      },
      "Object": {
        "properties": {},
        "type": "object"
      },
      "RecordDeploymentDto": {
        "properties": {
          "buildProof": {
            "type": "object"
          },
          "environment": {
            "type": "object"
          },
          "gitSha": {
            "type": "string"
          },
          "imageDigests": {
            "type": "object"
          },
          "status": {
            "type": "object"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "gitSha",
          "environment",
          "imageDigests",
          "buildProof",
          "status"
        ],
        "type": "object"
      },
      "ResumeJobDto": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": ["reason"],
        "type": "object"
      },
      "RevokeAdminSessionDto": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": ["reason"],
        "type": "object"
      },
      "UpdateRuntimeAiControlDto": {
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "reason": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": ["reason", "enabled"],
        "type": "object"
      },
      "UpdateUserStatusDto": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "type": "string"
          },
          "status": {
            "type": "object"
          }
        },
        "required": ["reason", "status"],
        "type": "object"
      },
      "WithdrawRedditSourceDto": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": ["reason"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "sylis_session": {
        "in": "cookie",
        "name": "sylis_session",
        "type": "apiKey"
      }
    }
  },

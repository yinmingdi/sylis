NODE_ENV=development
PORT=3700
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sylis
ADMIN_API_URL=http://localhost:3100
API_URL=http://localhost:3000
AGENT_API_URL=http://localhost:3200
MODEL_GATEWAY_URL=http://localhost:3300
SERVICE_GRANT_TOKEN=replace-automation-executor-token-32chars
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
QUARANTINE_BUCKET=sylis-quarantine
CLEAN_ASSET_BUCKET=sylis-assets
EXPORT_BUCKET=sylis-exports
AUDIT_ARCHIVE_BUCKET=sylis-audit-archives
AUDIT_ARCHIVE_ENCRYPTION_KEYS_JSON={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
AUDIT_ARCHIVE_ENCRYPTION_ACTIVE_KEY_VERSION=v1
SOURCE_SYNC_ALLOWED_ORIGINS=https://sources.example.com
JOB_HEARTBEAT_INTERVAL_MS=10000
AUTOMATION_FAILPOINT=NONE
AUTOMATION_FAILPOINT_DELAY_MS=1

enum ContentSource {
  ECDICT
  YOUDAO
  AI
}

enum ContentTrust {
  SOURCE_BACKED
  AI_EXPERIMENTAL
  HUMAN_VERIFIED
  REJECTED
}

enum LexicalCategory {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  DETERMINER
  ARTICLE
  NUMERAL
  INTERJECTION
  AUXILIARY
  PHRASE
  PROPER_NOUN
  ABBREVIATION
  OTHER
}

enum LexicalFormType {
  CANONICAL
  INFLECTED
  VARIANT
}

enum PronunciationRegion {
  GENERAL
  UK
  US
}

enum ExampleKind {
  GENERAL
  SOURCE_LABELED_EXAM
  AI_SIMULATION
}

enum SemanticRelationType {
  SYNONYM
  ANTONYM
}

enum LexemeRelationType {
  WORD_FAMILY
  DERIVED_FROM
  VARIANT
  ABBREVIATION
}

enum MediaType {
  IMAGE
  AUDIO
}

enum PracticeQuestionKind {
  MULTIPLE_CHOICE
  AI_SIMULATION
}

model LexiconSourceVersion {
  id            String                    @id @default(uuid())
  source        ContentSource
  version       String
  checksum      String
  artifactUri   String?
  status        String
  imported      Int                       @default(0)
  rejected      Int                       @default(0)
  createdAt     DateTime                  @default(now())
  activatedAt   DateTime?
  sourceRecords LexiconSourceRecord[]
  activations   LexiconSourceActivation[]

  @@unique([source, version])
  @@index([source, status])
}

model LexiconSourceActivation {
  source      ContentSource        @id
  versionId   String               @unique
  version     LexiconSourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  activatedAt DateTime             @default(now())
}

model LexiconSourceRecord {
  id                String                 @id @default(uuid())
  versionId         String
  wordId            String
  sourceKey         String
  sourceOrder       Int                    @default(0)
  rawPayloadHash    String
  projectionVersion Int                    @default(1)
  rawPayloadUri     String?
  version           LexiconSourceVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  word              Word                   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lexicalForms      LexicalForm[]
  pronunciations    FormPronunciation[]
  senses            LexicalSense[]
  glosses           SenseGloss[]
  examples          UsageExample[]
  citations         ExampleCitation[]
  collocations      Collocation[]
  semanticRelations SemanticRelation[]
  lexemeRelations   LexemeRelation[]
  mnemonics         Mnemonic[]
  media             WordMedia[]
  questions         WordPracticeQuestion[]

  @@unique([versionId, sourceKey])
  @@index([wordId, versionId])
}

model DictionaryImportRun {
  id           String    @id @default(uuid())
  source       String
  sourceCommit String
  checksum     String
  status       String
  scope        String    @default("all")
  selected     Int       @default(0)
  inserted     Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  relations    Int       @default(0)
  books        Int       @default(0)
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([source, startedAt])
}

model WordLexiconMetadata {
  id            String        @id @default(uuid())
  wordId        String
  source        ContentSource
  sourceVersion String
  tags          String[]
  bncRank       Int?
  frequencyRank Int?
  oxford        Boolean       @default(false)
  collins       Int?
  exchange      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  word          Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, source, sourceVersion])
  @@index([source])
  @@index([bncRank])
  @@index([frequencyRank])
}

model WordEnrichment {
  id             String           @id @default(uuid())
  wordId         String           @unique
  status         EnrichmentStatus @default(PENDING)
  contentVersion String
  attempts       Int              @default(0)
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  costCny        Decimal          @default(0) @db.Decimal(12, 6)
  lastError      String?
  lockedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  word           Word             @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model VocabularyEnrichmentRun {
  id               String           @id @default(uuid())
  scope            String
  status           EnrichmentStatus @default(PENDING)
  model            String
  contentVersion   String
  requested        Int              @default(0)
  processed        Int              @default(0)
  succeeded        Int              @default(0)
  failed           Int              @default(0)
  inputTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  costCny          Decimal          @default(0) @db.Decimal(12, 6)
  projectedCostCny Decimal?         @db.Decimal(12, 6)
  costCapCny       Decimal?         @db.Decimal(12, 6)
  error            String?
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?

  @@index([status, startedAt])
}

enum EnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

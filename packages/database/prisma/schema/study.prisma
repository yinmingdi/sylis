model PedagogicalMaterialCitation {
  id                String                   @id @default(uuid()) @db.Uuid
  releaseId         String                   @db.Uuid
  materialBlockId   String                   @db.Uuid
  contentEvidenceId String                   @db.Uuid
  block             PedagogicalMaterialBlock @relation(fields: [releaseId, materialBlockId], references: [releaseId, id], onDelete: Restrict)
  evidence          ContentEvidence          @relation(fields: [contentEvidenceId], references: [id], onDelete: Restrict)

  @@unique([releaseId, materialBlockId, contentEvidenceId])
}

model UserBookEnrollment {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  bookId        String                @db.Uuid
  editionId     String                @db.Uuid
  active        Boolean               @default(true)
  dailyNewLimit Int                   @default(20)
  enrolledAt    DateTime              @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?             @db.Timestamptz(3)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          VocabularyBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)
  edition       VocabularyBookEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  plans         DailyStudyPlan[]

  @@unique([userId, bookId, editionId])
}

model DailyStudyPlan {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  enrollmentId String?              @db.Uuid
  releaseId    String               @db.Uuid
  localDate    DateTime             @db.Date
  timezone     String
  status       DailyStudyPlanStatus
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment   UserBookEnrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  release      LexiconRelease       @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  items        DailyStudyPlanItem[]

  @@unique([userId, localDate])
  @@unique([releaseId, id])
}

model DailyStudyPlanItem {
  id                   String                    @id @default(uuid()) @db.Uuid
  releaseId            String                    @db.Uuid
  planId               String                    @db.Uuid
  objectiveRevisionId  String                    @db.Uuid
  position             Int
  mode                 StudyPlanItemMode
  recognitionDecision  StudyRecognitionDecision  @default(NOT_STARTED)
  correctStreak        Int                       @default(0)
  requiredCorrectCount Int                       @default(1)
  completedAt          DateTime?                 @db.Timestamptz(3)
  plan                 DailyStudyPlan            @relation(fields: [releaseId, planId], references: [releaseId, id], onDelete: Cascade)
  objectiveRevision    LearningObjectiveRevision @relation(fields: [releaseId, objectiveRevisionId], references: [releaseId, id], onDelete: Restrict)
  attempts             ExerciseAttempt[]

  @@unique([releaseId, id])
  @@unique([releaseId, planId, position])
  @@unique([releaseId, planId, objectiveRevisionId])
}

enum StudyRecognitionDecision {
  NOT_STARTED
  RECOGNIZED
  NOT_RECOGNIZED
}

model FSRSParameterSet {
  id          String        @id @default(uuid()) @db.Uuid
  version     String        @unique
  parameters  Json
  contentHash String        @unique
  effectiveAt DateTime      @db.Timestamptz(3)
  reviews     ReviewEvent[]
}

model UserObjectiveMemoryState {
  id                  String                    @id @default(uuid()) @db.Uuid
  userId              String                    @db.Uuid
  releaseId           String                    @db.Uuid
  objectiveId         String                    @db.Uuid
  objectiveRevisionId String                    @db.Uuid
  dueAt               DateTime                  @db.Timestamptz(3)
  fsrsState           Int                       @default(0)
  stability           Float
  difficulty          Float
  elapsedDays         Int                       @default(0)
  scheduledDays       Int                       @default(0)
  reviewCount         Int                       @default(0)
  lapseCount          Int                       @default(0)
  lastReviewedAt      DateTime?                 @db.Timestamptz(3)
  version             Int                       @default(0)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective           LearningObjective         @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  objectiveRevision   LearningObjectiveRevision @relation(fields: [releaseId, objectiveId, objectiveRevisionId], references: [releaseId, objectiveId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, objectiveId])
  @@index([userId, dueAt])
}

model ReviewEvent {
  id                  String                    @id @default(uuid()) @db.Uuid
  userId              String                    @db.Uuid
  releaseId           String                    @db.Uuid
  attemptId           String                    @db.Uuid
  objectiveRevisionId String                    @db.Uuid
  parameterSetId      String                    @db.Uuid
  rating              Int
  reviewedAt          DateTime                  @db.Timestamptz(3)
  idempotencyKey      String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt             ExerciseAttempt           @relation(fields: [releaseId, attemptId], references: [releaseId, id], onDelete: Restrict)
  objectiveRevision   LearningObjectiveRevision @relation(fields: [releaseId, objectiveRevisionId], references: [releaseId, id], onDelete: Restrict)
  parameterSet        FSRSParameterSet          @relation(fields: [parameterSetId], references: [id], onDelete: Restrict)
  snapshots           ReviewStateSnapshot[]

  @@unique([userId, idempotencyKey])
  @@unique([releaseId, id])
  @@unique([releaseId, attemptId])
}

model ReviewStateSnapshot {
  id            String              @id @default(uuid()) @db.Uuid
  releaseId     String              @db.Uuid
  reviewId      String              @db.Uuid
  phase         ReviewSnapshotPhase
  dueAt         DateTime            @db.Timestamptz(3)
  fsrsState     Int
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  review        ReviewEvent         @relation(fields: [releaseId, reviewId], references: [releaseId, id], onDelete: Restrict)

  @@unique([releaseId, reviewId, phase])
}

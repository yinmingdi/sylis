:{$PORT:8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /health {
		root * /srv
		rewrite * /version.json
		header Cache-Control "no-store"
		file_server
	}

	handle /version.json {
		root * /srv
		header Cache-Control "no-store"
		file_server
	}

	handle /internal/v1/deployment-releases {
		reverse_proxy {$ADMIN_API_UPSTREAM:http://admin-api.railway.internal:3100}
	}

	handle /api/* {
		reverse_proxy {$ADMIN_API_UPSTREAM:http://admin-api.railway.internal:3100}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

NODE_ENV=development
PORT=3200
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sylis
REDIS_URL=redis://localhost:6379
MODEL_GATEWAY_URL=http://localhost:3300
PRODUCT_API_URL=http://localhost:3000
PRODUCT_API_SERVICE_TOKEN=replace-agent-api-product-token-32chars
SERVICE_GRANT_TOKEN=replace-agent-api-gateway-token-32chars
SERVICE_GRANT_TOKENS_JSON={"api":"replace-api-agent-token-32chars","admin-api":"replace-admin-api-agent-token-32chars","agent-executor":"replace-agent-executor-token-32chars","agent-evaluator":"replace-agent-evaluator-token-32chars","asset-processor":"replace-asset-processor-token-32chars","automation-executor":"replace-automation-executor-token-32chars"}
SESSION_HASH_KEY=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
QUARANTINE_BUCKET=sylis-quarantine
CLEAN_ASSET_BUCKET=sylis-assets
MAX_ASSET_BYTES=26214400
